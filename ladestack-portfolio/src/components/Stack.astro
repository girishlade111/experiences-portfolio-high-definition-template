---
const stack = [
  'Astro',
  'React',
  'Next.js',
  'Vite',
  'Tailwind CSS',
  'TypeScript',
  'Node.js',
  'Supabase',
  'PostgreSQL',
  'NVIDIA NIM',
  'Monaco Editor',
  'Tiptap',
  'GSAP',
  'Three.js',
  'Cloudflare R2',
  'DigitalOcean',
  'Docker',
  'n8n',
];
---

<section id="stack" aria-labelledby="stack-heading" class="mx-auto w-full max-w-shell scroll-mt-20 px-5 py-10 sm:px-8">
  <div class="max-w-2xl">
    <h2
      id="stack-heading"
      class="tracking-tight-head text-4xl font-extrabold text-ink sm:text-5xl"
    >
      Stack.
    </h2>
    <p class="mt-3 text-[15px] leading-relaxed text-muted">
      The tools behind every LadeStack product.
    </p>
  </div>

  <ul class="mt-8 flex flex-wrap gap-2.5" aria-label="Technologies">
    {
      stack.map((t) => (
        <li class="glass rounded-full px-4 py-2 text-[13px] font-medium text-ink/80">
          {t}
        </li>
      ))
    }
  </ul>
</section>
